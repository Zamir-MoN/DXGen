# DXGen Backend Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DATABASE_URL=file:./dxgen.sqlite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=dxgen-production-secure-jwt-secret-key-replace-in-production-2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
RATE_LIMIT_HOUR=100
RATE_LIMIT_DAY=1000
APP_URL=http://localhost:5173
API_URL=http://localhost:3001/api/v1

# AI Image Generation (Pixazo)
IMAGE_PROVIDER=pixazo
PIXAZO_API_KEY=
PIXAZO_BASE_URL=https://gateway.pixazo.ai
IMAGE_DEFAULT_MODEL=flux-schnell
IMAGE_DEFAULT_WIDTH=1024
IMAGE_DEFAULT_HEIGHT=1024
IMAGE_REQUEST_TIMEOUT=60000
IMAGE_MAX_RETRIES=2
IMAGE_RATE_LIMIT_PER_MINUTE=5
IMAGE_RATE_LIMIT_PER_DAY=20
IMAGE_STORAGE_PROVIDER=external
